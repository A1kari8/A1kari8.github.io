---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="正则表达式测试器" description="测试正则表达式，支持多种标志和实时匹配">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="flex items-center justify-center mb-6">
                <div class="flex items-center gap-3">
                    <Icon name="material-symbols:code" class="text-2xl text-[var(--primary)]" />
                    <h2 class="text-2xl font-bold text-[var(--tw-prose-headings)]">正则表达式测试器</h2>
                </div>
            </div>
            
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- 输入区域 -->
                <div class="space-y-6">
                    <div class="bg-[var(--btn-regular-bg)] p-6 rounded-xl border border-[var(--line-divider)]">
                        <h3 class="text-lg font-semibold text-[var(--tw-prose-headings)] mb-4 flex items-center gap-2">
                            <Icon name="material-symbols:input-rounded" class="text-lg text-[var(--primary)]" />
                            正则表达式
                        </h3>
                        
                        <div class="space-y-4">
                            <input type="text" name="regex" placeholder="输入正则表达式..." 
                                   class="w-full p-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg font-mono text-sm focus:border-[var(--primary)] focus:outline-none transition-colors text-[var(--tw-prose-body)]" />
                            
                            <!-- 标志选项 -->
                            <div class="space-y-3">
                                <div class="text-sm font-medium text-[var(--tw-prose-body)]">标志选项</div>
                                <div class="grid grid-cols-3 gap-2">
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="checkbox" name="global" class="w-4 h-4 text-[var(--primary)] bg-[var(--card-bg)] border-[var(--line-divider)] rounded focus:ring-[var(--primary)] focus:ring-2" />
                                        <span class="text-sm text-[var(--tw-prose-body)]">g (全局)</span>
                                    </label>
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="checkbox" name="ignoreCase" class="w-4 h-4 text-[var(--primary)] bg-[var(--card-bg)] border-[var(--line-divider)] rounded focus:ring-[var(--primary)] focus:ring-2" />
                                        <span class="text-sm text-[var(--tw-prose-body)]">i (忽略大小写)</span>
                                    </label>
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="checkbox" name="multiline" class="w-4 h-4 text-[var(--primary)] bg-[var(--card-bg)] border-[var(--line-divider)] rounded focus:ring-[var(--primary)] focus:ring-2" />
                                        <span class="text-sm text-[var(--tw-prose-body)]">m (多行)</span>
                                    </label>
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="checkbox" name="dotAll" class="w-4 h-4 text-[var(--primary)] bg-[var(--card-bg)] border-[var(--line-divider)] rounded focus:ring-[var(--primary)] focus:ring-2" />
                                        <span class="text-sm text-[var(--tw-prose-body)]">s (点号匹配换行)</span>
                                    </label>
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="checkbox" name="unicode" class="w-4 h-4 text-[var(--primary)] bg-[var(--card-bg)] border-[var(--line-divider)] rounded focus:ring-[var(--primary)] focus:ring-2" />
                                        <span class="text-sm text-[var(--tw-prose-body)]">u (Unicode)</span>
                                    </label>
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="checkbox" name="sticky" class="w-4 h-4 text-[var(--primary)] bg-[var(--card-bg)] border-[var(--line-divider)] rounded focus:ring-[var(--primary)] focus:ring-2" />
                                        <span class="text-sm text-[var(--tw-prose-body)]">y (粘性)</span>
                                    </label>
                                </div>
                            </div>
                            
                            <div class="space-y-3">
                                <div class="text-sm font-medium text-[var(--tw-prose-body)]">测试文本</div>
                                <textarea name="testText" placeholder="输入要测试的文本..." rows="6" 
                                          class="w-full p-3 bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-lg font-mono text-sm focus:border-[var(--primary)] focus:outline-none transition-colors resize-none text-[var(--tw-prose-body)]"></textarea>
                            </div>
                            
                            <div class="flex gap-2">
                                <button type="button" id="testBtn" class="btn-plain scale-animation px-4 py-2 text-sm font-medium text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] rounded-lg transition-all duration-200">
                                    <Icon name="material-symbols:play-arrow" class="text-lg mr-1" />
                                    测试
                                </button>
                                <button type="button" id="clearBtn" class="btn-plain scale-animation px-4 py-2 text-sm font-medium text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] rounded-lg transition-all duration-200">
                                    <Icon name="material-symbols:clear-all" class="text-lg mr-1" />
                                    清空
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- 输出区域 -->
                <div class="space-y-6">
                    <div class="bg-[var(--btn-regular-bg)] p-6 rounded-xl border border-[var(--line-divider)]">
                        <h3 class="text-lg font-semibold text-[var(--tw-prose-headings)] mb-4 flex items-center gap-2">
                            <Icon name="material-symbols:output-rounded" class="text-lg text-[var(--primary)]" />
                            匹配结果
                        </h3>
                        
                        <div class="space-y-4">
                            <!-- 匹配状态 -->
                            <div id="matchStatus" class="hidden">
                                <div class="bg-[var(--card-bg)] p-4 rounded-lg border border-[var(--line-divider)]">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="text-sm font-medium text-[var(--tw-prose-body)]">匹配状态</span>
                                        <span id="matchCount" class="text-sm text-[var(--primary)] font-bold">0 个匹配</span>
                                    </div>
                                    <div id="matchDetails" class="text-sm text-[var(--tw-prose-body)]"></div>
                                </div>
                            </div>
                            
                            <!-- 高亮文本 -->
                            <div id="highlightedText" class="hidden">
                                <div class="bg-[var(--card-bg)] p-4 rounded-lg border border-[var(--line-divider)] min-h-[100px]">
                                    <div class="text-sm text-[var(--content-meta)] mb-2">高亮匹配结果</div>
                                    <div id="highlightedContent" class="font-mono text-sm text-[var(--tw-prose-body)] whitespace-pre-wrap"></div>
                                </div>
                            </div>
                            
                            <!-- 统计信息 -->
                            <div id="regexStats" class="hidden">
                                <div class="bg-[var(--card-bg)] p-4 rounded-lg border border-[var(--line-divider)]">
                                    <div class="text-sm text-[var(--content-meta)] mb-2">执行统计</div>
                                    <div class="grid grid-cols-2 gap-4 text-sm">
                                        <div>
                                            <div class="text-[var(--content-meta)]">执行时间</div>
                                            <div id="executionTime" class="font-bold text-[var(--primary)]">0ms</div>
                                        </div>
                                        <div>
                                            <div class="text-[var(--content-meta)]">正则长度</div>
                                            <div id="regexLength" class="font-bold text-[var(--primary)]">0</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</MainGridLayout>

<script type="module">
    function setupRegexTester() {
        const regexInput = document.querySelector('input[name="regex"]');
        const testTextInput = document.querySelector('textarea[name="testText"]');
        const testBtn = document.getElementById('testBtn');
        const clearBtn = document.getElementById('clearBtn');
        const matchStatus = document.getElementById('matchStatus');
        const matchCount = document.getElementById('matchCount');
        const matchDetails = document.getElementById('matchDetails');
        const highlightedText = document.getElementById('highlightedText');
        const highlightedContent = document.getElementById('highlightedContent');
        const regexStats = document.getElementById('regexStats');
        const executionTime = document.getElementById('executionTime');
        const regexLength = document.getElementById('regexLength');

        // 添加示例数据
        regexInput.value = '\\b\\w+@\\w+\\.\\w+\\b';
        testTextInput.value = `请测试以下邮箱地址：
user1@example.com
invalid-email
admin@test.org
another@domain.co.uk`;

        function getFlags() {
            const flags = [];
            if (document.querySelector('input[name="global"]').checked) flags.push('g');
            if (document.querySelector('input[name="ignoreCase"]').checked) flags.push('i');
            if (document.querySelector('input[name="multiline"]').checked) flags.push('m');
            if (document.querySelector('input[name="dotAll"]').checked) flags.push('s');
            if (document.querySelector('input[name="unicode"]').checked) flags.push('u');
            if (document.querySelector('input[name="sticky"]').checked) flags.push('y');
            return flags.join('');
        }

        function testRegex() {
            const regexPattern = regexInput.value.trim();
            const testText = testTextInput.value.trim();
            
            if (!regexPattern || !testText) {
                alert('请输入正则表达式和测试文本');
                return;
            }

            const startTime = performance.now();
            
            try {
                const flags = getFlags();
                const regex = new RegExp(regexPattern, flags);
                
                const matches = testText.match(regex);
                const allMatches = testText.matchAll(regex);
                const matchArray = Array.from(allMatches);
                
                const endTime = performance.now();
                const executionTimeMs = Math.round(endTime - startTime);
                
                // 显示匹配状态
                if (matches) {
                    matchCount.textContent = `${matches.length} 个匹配`;
                    matchDetails.innerHTML = matches.map((match, index) => 
                        `<div class="mb-1"><span class="text-[var(--primary)]">${index + 1}.</span> "${match}"</div>`
                    ).join('');
                    matchStatus.classList.remove('hidden');
                } else {
                    matchCount.textContent = '无匹配';
                    matchDetails.innerHTML = '<div class="text-[var(--content-meta)]">未找到匹配项</div>';
                    matchStatus.classList.remove('hidden');
                }
                
                // 高亮匹配结果
                if (matches && matches.length > 0) {
                    const highlighted = testText.replace(regex, (match) => 
                        `<span class="bg-yellow-200 dark:bg-yellow-800 text-black dark:text-white px-1 rounded">${match}</span>`
                    );
                    highlightedContent.innerHTML = highlighted;
                    highlightedText.classList.remove('hidden');
                } else {
                    highlightedText.classList.add('hidden');
                }
                
                // 显示统计信息
                executionTime.textContent = `${executionTimeMs}ms`;
                regexLength.textContent = regexPattern.length;
                regexStats.classList.remove('hidden');
                
            } catch (error) {
                alert(`正则表达式错误：${error.message}`);
                matchStatus.classList.add('hidden');
                highlightedText.classList.add('hidden');
                regexStats.classList.add('hidden');
            }
        }

        function clearAll() {
            regexInput.value = '';
            testTextInput.value = '';
            matchStatus.classList.add('hidden');
            highlightedText.classList.add('hidden');
            regexStats.classList.add('hidden');
        }

        // 事件监听
        testBtn.addEventListener('click', testRegex);
        clearBtn.addEventListener('click', clearAll);
        
        // 实时测试（可选）
        regexInput.addEventListener('input', () => {
            if (regexInput.value.trim() && testTextInput.value.trim()) {
                // 延迟执行，避免频繁测试
                clearTimeout(window.regexTestTimeout);
                window.regexTestTimeout = setTimeout(testRegex, 500);
            }
        });
    }

    // 页面加载完成后初始化
    document.addEventListener('DOMContentLoaded', setupRegexTester);
</script>
